# Public Firebase web configuration (safe for browsers)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# n8n workflow webhook (public; includes only public values)
VITE_N8N_WEBHOOK_URL=
VITE_N8N_SCHEDULE_WEBHOOK_URL=
# Shared webhook token. MUST equal the n8n environment variable WEBHOOK_SECRET
# (the workflow rejects requests without a matching `token`). It ships in the
# browser bundle, so it is a deterrent against casual abuse, not real auth.
VITE_N8N_WEBHOOK_TOKEN=

# DeepSeek-provided values never appear here — they live in n8n credentials.