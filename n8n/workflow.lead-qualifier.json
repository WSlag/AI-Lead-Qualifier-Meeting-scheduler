              "value": "={{ $json.ai.priority }}"
            },
            {
              "name": "intent",
              "value": "={{ $json.ai.intent }}"
            },
            {
              "name": "summary",
              "value": "={{ $json.ai.summary }}"
            },
            {
              "name": "recommendedAction",
