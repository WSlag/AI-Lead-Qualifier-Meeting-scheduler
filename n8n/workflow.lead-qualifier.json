    {
      "id": "b374e302-9ec6-442b-a992-6ce213f68b04",
      "name": "Validate Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1712,
        288
      ],
      "parameters": {
        "jsCode": "const { name, email, company, message } = $input.item.json;\n\nconst errors = {};\nif (!name || String(name).trim() === '') errors.name = 'name is required.';\nif (!email || String(email).trim() === '') errors.email = 'email is required.';\nelse if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(String(email).trim())) errors.email = 'email is not valid.';\nif (!message || String(message).trim() === '') errors.message = 'message is required.';\n\nif (Object.keys(errors).length > 0) {\n  return { json: { valid: false, errors } };\n}\n\nreturn { json: {\n  valid: true,\n  name: String(name).trim(),\n  email: String(email).trim(),\n  company: company ? String(company).trim() : '',\n  message: String(message).trim(),\n  source: 'WEB_FORM'\n} };"
      }
    },
    {
      "id": "valid-lead-if-1",
      "name": "Valid Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -1528,
        208
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
