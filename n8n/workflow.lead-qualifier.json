              "leftValue": "={{ $json.valid ?? false }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "id": "condition-valid-lead"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
