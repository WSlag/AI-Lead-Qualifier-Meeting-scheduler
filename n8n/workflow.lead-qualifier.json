          "company": "={{ $json.lead.company }}",
          "message": "={{ $json.lead.message }}",
          "score": "={{ $json.ai.score }}",
          "priority": "={{ $json.ai.priority }}",
          "intent": "={{ $json.ai.intent }}",
          "summary": "={{ $json.ai.summary }}",
          "recommendedAction": "={{ $json.ai.recommendedAction }}",
          "status": "NEW",
