      "id": "webhook-lead",
      "name": "Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1984, -64],
      "webhookId": "webhook-lead"
    },
    {
      "parameters": {
        "jsCode": "const { name, email, company, message } = $input.item.json;\n\nconst errors = {};\nif (!name || String(name).trim() === '') errors.name = 'name is required.';\nif (!email || String(email).trim() === '') errors.email = 'email is required.';\nelse if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(String(email).trim())) errors.email = 'email is not valid.';\nif (!message || String(message).trim() === '') errors.message = 'message is required.';\n\nif (Object.keys(errors).length > 0) {\n  throw new Error(JSON.stringify({ code: 400, errors }));\n}\n\nreturn { json: {\n  name: String(name).trim(),\n  email: String(email).trim(),\n  company: company ? String(company).trim() : '',\n  message: String(message).trim(),\n  source: 'WEB_FORM'\n} };"
      },
      "id": "code-validate",
      "name": "Validate Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1728, -64]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.deepseek.com/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$credentials.value}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"model\": \"deepseek-chat\",\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"You are a sales lead qualification assistant. Analyze the supplied lead information and return ONLY valid JSON. Score the lead from 0 to 100 based on apparent business need, relevance, buying intent, and clarity of the request. Priority: HIGH (80-100), MEDIUM (50-79), LOW (0-49). Do not invent facts not present in the lead. Response must be JSON with keys: score, priority, intent, summary, recommendedAction.\" },\n    { \"role\": \"user\", \"content\": \"Lead: name={{ $json.name }}, email={{ $json.email }}, company={{ $json.company }}, message={{ $json.message }}\" }\n  ]\n}",
        "options": {}
      },
      "id": "http-deepseek",
      "name": "DeepSeek Qualification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-1504, -64]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.item.json;\nconst content = raw?.choices?.[0]?.message?.content;\nif (!content) throw new Error('DeepSeek returned no content.');\nconst ai = JSON.parse(content);\n\nconst validPriority = ['LOW', 'MEDIUM', 'HIGH'];\nconst score = Number(ai.score);\nlet priority = String(ai.priority || '').toUpperCase();\nif (!validPriority.includes(priority)) {\n  priority = score >= 80 ? 'HIGH' : score >= 50 ? 'MEDIUM' : 'LOW';\n}\nif (score < 0 || score > 100) throw new Error('Invalid score from DeepSeek.');\n\nreturn { json: {\n  lead: raw.body || raw,\n  ai: {\n    score,\n    priority,\n    intent: String(ai.intent || ''),\n    summary: String(ai.summary || ''),\n    recommendedAction: String(ai.recommendedAction || '')\n  }\n} };"
      },
      "id": "code-parse",
      "name": "Parse DeepSeek JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1280, -64]
    },
