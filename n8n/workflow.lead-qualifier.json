    {
      "id": "f3b73877-8f79-42f9-a264-19773b769796",
      "name": "Score >= 80?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -832,
        288
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $('Parse DeepSeek JSON').item.json.ai.score ?? 0 }}",
              "rightValue": 80,
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "id": "condition-high"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
